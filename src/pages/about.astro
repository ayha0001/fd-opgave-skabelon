---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import HeroBgWrapper from "@components/helpers/HeroBgWrapper.astro";
import IdeasToReality from "@components/IdeasToReality.astro";
import CoreValues from "@components/CoreValues.astro";
import OurTeamIntro from "@components/OurTeamIntro.astro";
import team from "@data/employees.json";
import TeamProfile from "@components/TeamProfile.astro";
import Newsletter from "@components/Newsletter.astro";
import Footer from "@components/Footer.astro";

const topThree = team.slice(0, 3);
---

<Layout>
  <Header />
  <HeroBgWrapper imagePath='hero2.jpg' class='hero'>
    <header class='hero-header'>
      <p>ABOUT</p>
      <h1>Creative Services For Boost Your Business Growth</h1>
    </header>
  </HeroBgWrapper>
  <IdeasToReality imagePath='/src/data/images/photo6.jpg' altText='Our team working together' class='rounded-lg' width={634} height={395} />
  <CoreValues surface='secondary' />
  <OurTeamIntro />
  <section>
    {
      topThree.map((member) => (
        <TeamProfile
          image={member.img}
          alt={member.title}
          job={member.title}
          name={member.name}
          bio={member.description}
          social_links={member.social_links}
        />
      ))
    }
  </section>
  <Newsletter />
  <Footer />
</Layout>

<style>
  section {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 50px;
    align-items: stretch;
    justify-items: center;
    max-width: 1200px;
    margin-inline: auto;
    padding: 0 2rem;
  }

  @media (min-width: 800px) {
    section {
      padding: 0;
    }
  }
</style>
