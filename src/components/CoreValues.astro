---
// Henter data fra JSON-fil
import values from "@data/coreValues.json";

// Hent ALLE svg’er som URL’er
const icons = import.meta.glob("/src/icons/*.svg", { eager: true, as: "url" });

// (valgfrit) variabel til overskrift
const sectionLabel = "GROWING WITH OUR CLIENTS";
const { surface = "primary" } = Astro.props;
---

<section class='core-values-section' data-surface={surface}>
  <div class='width-container'>
    <div class='core-values'>
      <div class='core-values-text'>
        <small>{sectionLabel}</small>
        <h2>{values.title}</h2>
        <p>{values.subtitle}</p>
      </div>

      <a href={values.button.link} class='blackbtn'>
        {values.button.text}
      </a>
    </div>

    <div class='values-grid'>
      {
        values.values.map((item) => {
          // Find den korrekte ikon-url baseret på ikon-navnet i JSON dataen
          const iconPath = icons[`/src/icons/${item.icon}.svg`];
          return (
            <div class='value-item card'>
              {iconPath && <img src={iconPath} alt='' class='icon' width='40' height='40' loading='lazy' decoding='async' />}
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <a href={item.link.url}>
                {item.link.text} <img src={icons["/src/icons/arrow--right.svg"]} class='arrow-icon' width='18' height='18' />
              </a>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .core-values-text {
    color: var(--text-section);
  }

  .core-values-text p {
    color: var(--text-section);
  }

  /* Link og pil */
  .value-item a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    text-decoration: none;
    color: inherit;
    margin-top: 20px;
    transition: transform 0.3s ease;
    transform-origin: left center;
  }

  .arrow-icon {
    width: 16px;
    height: 16px;
  }
  .value-item a:hover {
    transform: scale(1.1);
  }

  .icon {
    margin-bottom: 20px;
  }

  /* Container der begrænser bredden af indholdet */
  .width-container {
    max-width: 1200px;
    /* centrér indhold og begræns linjelængde */
    margin-inline: auto;
    padding: 89px 0;
  }

  /* Styling af den lille titel over overskriften */
  .core-values-text small {
    display: block;
    letter-spacing: 0.08em;
    font-weight: 600;
    margin-bottom: 15px;
  }

  /* Styling af den overordnede container */
  .core-values {
    display: grid;
    text-align: center;
    justify-items: center;
    gap: 20px;
  }

  /* Styling af hele sektionen */
  .core-values-section {
    background: var(--bg-section);
    /* Responsiv padding. 1.25rem minimun, 2rem maximun */
    padding: clamp(1.25rem, 2vw, 2rem);
  }

  /* Styling af grid til indholdet som hentes dynamisk */
  .values-grid {
    display: grid;
    gap: 30px;
    /* Automatiske kolonner baseret på skærmbredde */
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    margin-top: 40px;
  }

  /* Styling af indholdet i de inviduelle items */
  .value-item {
    background: var(--bg-card);
    color: var(--card-text);
    /* kun for ens højde og pæn wrap af indhold */
    display: grid;
    align-content: start;
    padding: 36px 23px;
    border-radius: 20px;
  }

  .values-grid a {
    color: var(--a-link);
  }

  .values-grid h3 {
    color: var(--p-text);
  }

  @media (min-width: 800px) {
    h2 {
      font-size: var(--heading02);
    }

    p {
      font-size: var(--default-body);
    }

    .core-values-text small {
      font-size: var(--default-body);
    }

    .core-values {
      grid-template-columns: 1fr 1fr;
      justify-items: end; /* gør indhold kun så bredt som det skal være */
      align-items: end; /* gør indhold kun så højt som det skal være */
      text-align: left;
      gap: 2rem;
    }
  }
</style>
