---
// Henter data fra JSON-fil
import data from "@data/financialProjections.json";

// Hent ALLE svg’er som URL’er
const icons = import.meta.glob("/src/icons/*.svg", { eager: true, as: "url" });
---

<section>
  <div class='container'>
    <div class='text-section'>
      <div>
        <h2>{data.title}</h2>
        <p>{data.subtitle}</p>
      </div>

      <div class='arrows'>
        <a href=''></a>
      </div>
    </div>
    <ul role='list'>
      {
        data.values.map((item) => {
          const iconPath = icons[`/src/icons/${item.icon}.svg`];
          return (
            <li>
              {iconPath && <img src={iconPath} alt='' class='icon' width='40' height='40' loading='lazy' decoding='async' />}
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  section {
    background-color: var(--secondary01);
  }

  .icon {
    margin-bottom: 15px;
  }

  .arrows {
    display: flex;
    gap: 30px;
  }

  .arrows a:nth-of-type(1) img {
    background-color: var(--primary01);
    border-radius: 30px;
  }

  .arrows a:nth-of-type(2) img {
    background-color: var(--primary03);
    border-radius: 30px;
  }

  .text-section {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    text-align: center;
    place-items: center;
    padding: 0 0 50px;
  }

  :root {
    --content-width: 1200px;
  }

  .container {
    padding-block: 89px;
    display: grid;
    grid-template-columns:
      [full-start]
      1fr
      [content]
      minmax(0, var(--content-width))
      1fr
      [full-end];
    column-gap: 1rem;

    > * {
      grid-column: content;
    }

    .full {
      grid-column: full;
      display: grid;
      grid-template-columns: inherit;
      row-gap: 3rem;

      > * {
        grid-column: content;
      }

      > ul {
        scroll-snap-type: x mandatory;
        grid-column: full;
        padding-inline: max(1rem, 50% - var(--content-width) / 2);
        padding-block-end: 1rem;

        li {
          scroll-snap-align: center;
        }
      }
    }
  }

  .container > ul[role="list"] {
    grid-column: full;
    scroll-snap-type: x mandatory;
    padding-inline: max(1rem, 50% - var(--content-width) / 2);
    padding-block-end: 1rem;
  }

  ul {
    display: flex;
    gap: 1rem;
    overflow-x: auto;

    li {
      flex-basis: min(400px, 90%);
      flex-shrink: 0;
      background: #ebebeb;
      color: #595566;
      border-radius: 8px;
      font-size: 1rem;
      padding: 2.75rem 2.1875rem;
      align-self: start;

      h3 {
        font-weight: 700;
        font-size: 1.5625rem;
      }
    }
  }

  h2,
  h3 {
    all: revert;
    color: #181818;
    margin-block: 0 0.625rem;
    line-height: 1.125;
  }

  h2 {
    font-size: 2.8125rem;
  }

  @media (min-width: 800px) {
    .text-section {
      grid-template-columns: 1fr 1fr;
      text-align: left;
    }

    .arrows {
      place-self: end;
    }
  }
</style>
